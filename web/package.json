{
  "name": "webtemis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build:wasm": "wasm-pack build ../crates/genome-wasm --target web --out-dir ../../web/src/lib/wasm-pkg --out-name genome_wasm",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
