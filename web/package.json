{
  "name": "genbank_viewer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build:wasm": "wasm-pack build ../crates/genome-wasm --target web --out-dir ../../web/src/lib/wasm-pkg --out-name genome_wasm",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test tests/smoke.spec.ts",
    "docs:screenshots": "playwright test tests/docs-screenshots.spec.ts",
    "docs:audit": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.8",
    "svelte-check": "^3.8.6",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
